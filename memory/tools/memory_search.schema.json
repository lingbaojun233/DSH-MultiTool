{
  "name": "memory_search",
  "description": "Recall memories (facts/events) under a strict count+token budget. Returns evidence for every item; empty when nothing matches.",
  "parameters": {
    "type": "object",
    "required": ["query"],
    "properties": {
      "query": { "type": "string", "description": "Natural-language query or keywords" },
      "max_items": { "type": "integer", "minimum": 1, "maximum": 32, "default": 8 },
      "max_tokens": { "type": "integer", "minimum": 50, "maximum": 4000, "default": 1200 }
    }
  }
}
